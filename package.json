{
  "name": "kube-mobile",
  "version": "1.0.0",
  "description": "View K8s pod logs from your phone",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch src/index.ts\" \"cd web && pnpm dev\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "cd web && pnpm dev",
    "build": "cd web && pnpm build",
    "start": "tsx src/index.ts"
  },
  "keywords": [
    "kubectl",
    "logs",
    "mobile"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.7.4"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "concurrently": "^9.2.1",
    "fastify-tsconfig": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
